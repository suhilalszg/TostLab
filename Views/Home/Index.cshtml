@model PanoRaporu
@{
    ViewData["Title"] = "Bugün";
    ViewData["UstBarYok"] = true;   // başlığı bu sayfa kendisi çizer (aralık düğmeleriyle)

    var rapor = Model.Rapor;
    var ozet = rapor.Ozet;
    var turkce = new System.Globalization.CultureInfo("tr-TR");
    // Çalışan ciro görmez: para yazan her şey bu değişkene bağlı.
    // Sunucuda çizildiği için çalışanın tarayıcısına para bilgisi hiç gitmez.
    bool yoneticiMi = User.IsInRole(Roller.Yonetici);

    string baslik = Model.Aralik switch { PanoAraligi.Dun => "DÜN", PanoAraligi.Hafta => "BU HAFTA", _ => "BUGÜN" };
    string tarihYazisi = Model.Aralik == PanoAraligi.Hafta
        ? $"{Model.Baslangic.ToString("d MMMM", turkce)} – {Model.Bitis.AddDays(-1).ToString("d MMMM", turkce)}"
        : Model.Baslangic.ToString("dddd, d MMMM", turkce);
    if (Model.IlkSiparis is DateTime ilk && Model.Aralik != PanoAraligi.Hafta)
    {
        tarihYazisi += $" · ilk sipariş {ilk:HH:mm}";
    }

    // Saatlik grafik (boş saatler 0, en yoğun iki saat sarı): hesap GunRaporu'nda
    var saatlik = rapor.SaatlikDolu;
    int enCokAdet = rapor.EnCokSaatAdedi;
    var yogunSaatler = rapor.YogunSaatler;

    decimal enBuyukKaynak = rapor.KaynakKirilimi.Count == 0 ? 1 : Math.Max(1, rapor.KaynakKirilimi.Max(k => k.Tutar));

    string Para(decimal tutar) => tutar.ToString("N0", turkce) + " ₺";

    // İkram / iade / silinen ürün / iskonto: varsa tek satırlık not
    var notlar = new List<string>();
    if (ozet.IkramAdedi > 0) notlar.Add(yoneticiMi ? $"{ozet.IkramAdedi} ikram ({Para(ozet.IkramTutari)})" : $"{ozet.IkramAdedi} ikram");
    if (ozet.IadeSayisi > 0) notlar.Add(yoneticiMi ? $"{ozet.IadeSayisi} iade ({Para(ozet.IadeTutari)})" : $"{ozet.IadeSayisi} iade");
    if (yoneticiMi && ozet.SilinenUrunAdedi > 0) notlar.Add($"adisyonlardan {ozet.SilinenUrunAdedi} ürün silindi ({Para(ozet.SilinenTutar)})");
    if (yoneticiMi && ozet.IndirimToplami > 0) notlar.Add($"{Para(ozet.IndirimToplami)} iskonto");
}

@section Stiller {
    <link rel="stylesheet" href="~/css/pano.css" asp-append-version="true" />
}

<div class="pano">
    <header class="pano-ust">
        <div>
            <h1>@baslik</h1>
            <span class="pano-tarih">@tarihYazisi</span>
        </div>
        <div class="pano-sag">
            <nav class="aralik-secici">
                <a asp-action="Index" class="@(Model.Aralik == PanoAraligi.Bugun ? "secili" : "")">Bugün</a>
                <a asp-action="Index" asp-route-aralik="Dun" class="@(Model.Aralik == PanoAraligi.Dun ? "secili" : "")">Dün</a>
                <a asp-action="Index" asp-route-aralik="Hafta" class="@(Model.Aralik == PanoAraligi.Hafta ? "secili" : "")">Bu hafta</a>
            </nav>
            <a asp-controller="Satis" asp-action="Index" class="yeni-siparis">+ Yeni sipariş</a>
        </div>
    </header>

    @* ---------- Rakam kutuları ---------- *@
    <section class="pano-kutular @(yoneticiMi ? "" : "calisan")">
        @if (yoneticiMi)
        {
            <div class="pano-kutu one-cikan">
                <span class="etiket">Net kazanç</span>
                <b>@Para(ozet.NetKazanc)</b>
                <small>komisyon sonrası</small>
            </div>
            <div class="pano-kutu">
                <span class="etiket">Brüt ciro</span>
                <b>@Para(ozet.Ciro)</b>
                @if (Model.DegisimYuzdesi is decimal degisim)
                {
                    <small><span class="@(degisim >= 0 ? "artis" : "azalis")">@(degisim >= 0 ? "▲" : "▼") %@Math.Abs(degisim).ToString("0", turkce)</span> @Model.OncekiAdi</small>
                }
                else
                {
                    <small>@Model.OncekiAdi satış yok</small>
                }
            </div>
        }
        <div class="pano-kutu">
            <span class="etiket">Sipariş</span>
            <b>@ozet.OdenenSayisi</b>
            @if (yoneticiMi)
            {
                <small>ortalama fiş @Para(rapor.OrtalamaAdisyon)</small>
            }
            else
            {
                <small>@ozet.AcikSayisi açık adisyon</small>
            }
        </div>
        @if (yoneticiMi)
        {
            <div class="pano-kutu">
                <span class="etiket">Komisyon</span>
                <b class="@(ozet.Komisyon > 0 ? "eksi" : "")">@(ozet.Komisyon > 0 ? "−" : "")@Para(ozet.Komisyon)</b>
                <small>@(ozet.Komisyon > 0 ? $"platform cirosundan %{Model.KomisyonYuzdesi.ToString("0", turkce)}" : "platform siparişi yok")</small>
            </div>
        }
        <div class="pano-kutu">
            <span class="etiket">İptal</span>
            <b>@ozet.IptalSayisi</b>
            @if (yoneticiMi && ozet.IptalTutari > 0)
            {
                <small class="eksi">@Para(ozet.IptalTutari) kayıp</small>
            }
            else
            {
                <small>&nbsp;</small>
            }
        </div>
    </section>

    @* ---------- Saatlik + kaynak ---------- *@
    <section class="pano-izgara ust @(yoneticiMi ? "" : "tek")">
        <div class="pano-kart">
            <div class="kart-baslik">
                <h2>Saatlik sipariş</h2>
                @if (yogunSaatler.Count > 0)
                {
                    <span>en yoğun @string.Join(" ve ", yogunSaatler.Select(s => $"{s:00}:00"))</span>
                }
            </div>
            @if (saatlik.Count == 0)
            {
                <p class="pano-bos">Henüz sipariş yok.</p>
            }
            else
            {
                <div class="saat-grafik">
                    @foreach (var saat in saatlik)
                    {
                        <div class="saat-sutun">
                            <span class="sayi">@(saat.Adet > 0 ? saat.Adet.ToString() : "")</span>
                            <div class="cubuk @(yogunSaatler.Contains(saat.Saat) ? "yogun" : "")" style="height:@(saat.Adet * 100 / enCokAdet)%"></div>
                            <span class="saat">@saat.Saat</span>
                        </div>
                    }
                </div>
            }
        </div>

        @if (yoneticiMi)
        {
            <div class="pano-kart">
                <div class="kart-baslik">
                    <h2>Kaynak</h2>
                    <span>net · <i class="kirmizi-yazi">kırmızı</i> = komisyon</span>
                </div>
                @if (rapor.KaynakKirilimi.Count == 0)
                {
                    <p class="pano-bos">Henüz ödenen sipariş yok.</p>
                }
                else
                {
                    <div class="kaynak-liste">
                        @foreach (var kaynak in rapor.KaynakKirilimi)
                        {
                            <div class="kaynak-satir">
                                <span class="ad">@kaynak.Ad <small>@kaynak.Adet</small></span>
                                <div class="kaynak-cubuk">
                                    <div class="net" style="width:@(((kaynak.Tutar - kaynak.Komisyon) * 100 / enBuyukKaynak).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                    <div class="komisyon" style="width:@((kaynak.Komisyon * 100 / enBuyukKaynak).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <b>@((kaynak.Tutar - kaynak.Komisyon).ToString("N0", turkce))</b>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>

    @* ---------- En çok satanlar + son siparişler ---------- *@
    <section class="pano-izgara alt">
        <div class="pano-kart">
            <div class="kart-baslik">
                <h2>En çok satanlar</h2>
                <span>@(yoneticiMi ? "adet · ciro" : "adet")</span>
            </div>
            @if (rapor.EnCokSatanlar.Count == 0)
            {
                <p class="pano-bos">Henüz satış yok.</p>
            }
            else
            {
                <ol class="cok-satan-liste">
                    @for (int sira = 0; sira < rapor.EnCokSatanlar.Count; sira++)
                    {
                        var urun = rapor.EnCokSatanlar[sira];
                        <li>
                            <span class="sira">@((sira + 1).ToString("00"))</span>
                            <span class="ad">@urun.Ad</span>
                            <b>@urun.Adet</b>
                            @if (yoneticiMi) { <span class="tutar">@Para(urun.Tutar)</span> }
                        </li>
                    }
                </ol>
            }
        </div>

        <div class="pano-kart">
            <div class="kart-baslik">
                <h2>Son siparişler</h2>
                @if (yoneticiMi)
                {
                    <a asp-controller="Adisyon" asp-action="Index" asp-route-tarih="@Model.Baslangic.ToString("yyyy-MM-dd")">tümü →</a>
                }
            </div>
            @if (Model.SonSiparisler.Count == 0)
            {
                <p class="pano-bos">Henüz sipariş yok.</p>
            }
            else
            {
                <table class="son-siparisler @(yoneticiMi ? "" : "tutarsiz")">
                    <thead>
                        <tr>
                            <th>No</th><th>Saat</th><th>Kaynak</th><th>Ürünler</th>
                            @if (yoneticiMi) { <th class="sag tutar-baslik">Tutar</th> }
                            <th class="sag durum-baslik">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var siparis in Model.SonSiparisler)
                        {
                            <tr class="@(siparis.Durum == AdisyonDurumu.Iptal ? "soluk" : "")">
                                <td class="no">#@siparis.Id</td>
                                <td>@siparis.Saat.ToString("HH:mm")</td>
                                <td><span class="nokta kaynak-@siparis.Kaynak.ToLowerInvariant()"></span>@siparis.Baslik</td>
                                <td class="urunler" title="@siparis.Urunler">@(string.IsNullOrEmpty(siparis.Urunler) ? "—" : siparis.Urunler)</td>
                                @if (yoneticiMi) { <td class="sag tutar">@Para(siparis.Toplam)</td> }
                                <td class="sag"><span class="durum-hap @siparis.Durum.ToString().ToLowerInvariant()">@DurumYazisi.Yaz(siparis.Durum)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    @if (notlar.Count > 0)
    {
        <p class="pano-not">
            @string.Join(" · ", notlar)
            @if (yoneticiMi) { <a asp-controller="Adisyon" asp-action="Index" asp-route-tarih="@Model.Baslangic.ToString("yyyy-MM-dd")">Adisyon panelinde gör</a> }
        </p>
    }
</div>
