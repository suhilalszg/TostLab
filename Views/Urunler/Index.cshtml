@model MenuSayfasi
@{
    ViewData["Title"] = "Menü";
}

@* menu.js bu anahtarı her istekte gönderir (sahte istekleri engeller) *@
@Html.AntiForgeryToken()

@if (TempData["Bildirim"] is string bildirim)
{
    <div class="alert alert-success">@bildirim</div>
}

<div class="menu-duzen">
    <aside class="kategori-listesi">
        <div class="ozet">
            <span><b id="sayac-toplam">@Model.ToplamUrun</b> ürün</span>
            <span><b id="sayac-satista">@Model.SatistakiUrun</b> satışta</span>
        </div>
        <nav>
            @foreach (var kategori in Model.Kategoriler)
            {
                <a href="#@MenuSayfasi.KategoriKimligi(kategori)" data-kategori="@MenuSayfasi.KategoriKimligi(kategori)">
                    <span>@kategori</span>
                    <small>@Model.Urunler.Count(urun => urun.Kategori == kategori)</small>
                </a>
            }
        </nav>
    </aside>

    <section class="menu-urunler">
        <div class="menu-arac">
            <input type="search" id="menu-ara" class="form-control" placeholder="Ara: ürün veya malzeme" autocomplete="off" />
            <button type="button" id="fiyatsiz-suz" class="suzgec @(Model.FiyatsizUrun > 0 ? "uyari" : "")">
                Fiyatsız <b id="sayac-fiyatsiz">@Model.FiyatsizUrun</b>
            </button>
            <a class="btn btn-dark" asp-action="Ekle">+ Ürün</a>
        </div>

        <p class="ipucu">Fiyatı kutuya yaz, <kbd>Enter</kbd>'a bas: kaydedilir ve alttakine geçer.</p>

        @foreach (var grup in Model.Urunler.GroupBy(urun => urun.Kategori))
        {
            <div class="kategori-blok" id="@MenuSayfasi.KategoriKimligi(grup.Key)">
                <h2 class="kategori-baslik">@grup.Key</h2>

                @foreach (var urun in grup)
                {
                    <div class="urun-satir @(urun.SatistaMi ? "" : "kapali")" data-id="@urun.Id"
                         data-ara="@(urun.Ad + " " + urun.Icindekiler)">
                        <div class="urun-bilgi">
                            <b>@urun.Ad</b>
                            @if (!string.IsNullOrEmpty(urun.Icindekiler))
                            {
                                <span>@urun.Icindekiler</span>
                            }
                        </div>

                        <label class="fiyat-kutu">
                            <input type="text" inputmode="decimal" class="fiyat-gir" placeholder="—"
                                   value="@MenuSayfasi.FiyatYazisi(urun.Fiyat)" aria-label="@urun.Ad fiyatı" />
                            <span>₺</span>
                        </label>

                        <button type="button" class="anahtar @(urun.SatistaMi ? "acik" : "")"
                                title="Satışa aç / kapat" aria-label="@urun.Ad satışta mı"></button>

                        <a asp-action="Duzenle" asp-route-id="@urun.Id" class="kalem" title="Düzenle">✎</a>
                    </div>
                }

                <form class="hizli-ekle" data-kategori="@grup.Key">
                    <input type="text" name="ad" placeholder="+ @grup.Key içine yeni ürün" autocomplete="off" />
                    <input type="text" name="fiyat" inputmode="decimal" placeholder="Fiyat" autocomplete="off" />
                    <button type="submit">Ekle</button>
                </form>
            </div>
        }

        <div class="kart bos-sonuc" hidden>Aramaya uyan ürün yok.</div>
    </section>
</div>

@section Scripts {
    <script src="~/js/menu.js" asp-append-version="true"></script>
}
