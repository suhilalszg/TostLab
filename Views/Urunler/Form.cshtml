@model UrunFormu
@{
    // Aynı form hem "Ekle" hem "Düzenle" için kullanılıyor: Id 0 ise yeni ürün
    bool yeniMi = Model.Id == 0;
    ViewData["Title"] = yeniMi ? "Ürün ekle" : "Ürünü düzenle";
    var kategoriler = ViewData["Kategoriler"] as List<string> ?? new List<string>();
}

<form asp-action="@(yeniMi ? "Ekle" : "Duzenle")" asp-route-id="@(yeniMi ? null : Model.Id)" method="post" class="kart" style="max-width: 520px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Ad" class="form-label"></label>
        <input asp-for="Ad" class="form-control" autocomplete="off" />
        <span asp-validation-for="Ad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fiyat" class="form-label"></label>
        <input asp-for="Fiyat" class="form-control" inputmode="decimal" value="@(Model.Fiyat == 0 ? "" : Model.Fiyat.ToString("0.##"))" placeholder="örn. 90 veya 92,50" />
        <span asp-validation-for="Fiyat" class="text-danger"></span>
        <div class="form-text">Kuruş için virgül kullan. Fiyat değişirse eski siparişler etkilenmez.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Kategori" class="form-label"></label>
        <input asp-for="Kategori" class="form-control" list="kategori-listesi" autocomplete="off" placeholder="Listeden seç ya da yeni yaz" />
        <datalist id="kategori-listesi">
            @foreach (var kategori in kategoriler)
            {
                <option value="@kategori"></option>
            }
        </datalist>
        <span asp-validation-for="Kategori" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Icindekiler" class="form-label"></label>
        <textarea asp-for="Icindekiler" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Icindekiler" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="SatistaMi" class="form-check-input" />
        <label asp-for="SatistaMi" class="form-check-label">Satışta (sipariş ekranında görünsün)</label>
    </div>

    <button type="submit" class="btn btn-dark">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts {
    <script>
        // "92.50" yazılırsa Türkçe biçime çevir: "92,50" (yoksa 9250 diye okunur)
        document.querySelector('form.kart').addEventListener('submit', function () {
            const fiyatKutusu = document.getElementById('Fiyat');
            fiyatKutusu.value = fiyatKutusu.value.trim().replace('.', ',');
        });
    </script>
}

@if (!yeniMi)
{
    <form asp-action="Sil" asp-route-id="@Model.Id" method="post" class="mt-3" style="max-width: 520px"
          onsubmit="return confirm('Bu ürün menüden silinsin mi?');">
        <button type="submit" class="btn btn-outline-danger btn-sm">Ürünü sil</button>
        <span class="form-text ms-2">Daha önce sipariş edildiyse silinmez, satıştan kaldırılır.</span>
    </form>
}
