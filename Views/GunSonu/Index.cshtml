@model GunRaporu
@{
    ViewData["Title"] = "Gün sonu";
    ViewData["UstBarYok"] = true;
    var ozet = Model.Ozet;
    var turkce = new System.Globalization.CultureInfo("tr-TR");
    string Para(decimal tutar) => tutar.ToString("N2", turkce) + " ₺";
    string GunAdresi(DateTime hedef) => Url.Action("Index", new { gun = hedef.ToString("yyyy-MM-dd") })!;

    // Kasa sayımı için: nakit ödemelerin toplamı kasada olmalı
    var nakit = Model.OdemeKirilimi.FirstOrDefault(odeme => odeme.Ad.Equals("Nakit", StringComparison.OrdinalIgnoreCase));
}

@section Stiller {
    <link rel="stylesheet" href="~/css/pano.css" asp-append-version="true" />
}

<div class="pano">
    <header class="pano-ust">
        <div>
            <h1>GÜN SONU</h1>
            <span class="pano-tarih">@Model.Gun.ToString("d MMMM yyyy, dddd", turkce)</span>
        </div>
        <div class="pano-sag">
            <form method="get" class="tarih-secici">
                <a href="@GunAdresi(Model.Gun.AddDays(-1))" title="Önceki gün">‹</a>
                <input type="date" name="gun" value="@Model.Gun.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                <a href="@GunAdresi(Model.Gun.AddDays(1))" title="Sonraki gün">›</a>
            </form>
            <a class="aralik-buton" asp-action="Ay" asp-route-yil="@Model.Gun.Year" asp-route-ay="@Model.Gun.Month">Aylık rapor</a>
            <a class="yeni-siparis" asp-controller="Adisyon" asp-action="Index" asp-route-tarih="@Model.Gun.ToString("yyyy-MM-dd")">Adisyon paneli →</a>
        </div>
    </header>

    @if (ozet.AcikSayisi > 0)
    {
        <p class="pano-uyari"><b>@ozet.AcikSayisi</b> adisyon hâlâ açık: kapatılmadan ciroya girmez. Günü bitirmeden önce Satış ekranından kapat.</p>
    }

    <section class="pano-kutular alti">
        <div class="pano-kutu one-cikan">
            <span class="etiket">Net kazanç</span>
            <b>@Para(ozet.NetKazanc)</b>
            <small>komisyon sonrası</small>
        </div>
        <div class="pano-kutu">
            <span class="etiket">Brüt ciro</span>
            <b>@Para(ozet.Ciro)</b>
            <small>@ozet.OdenenSayisi adisyon</small>
        </div>
        <div class="pano-kutu">
            <span class="etiket">Ortalama fiş</span>
            <b>@Para(Model.OrtalamaAdisyon)</b>
            <small>adisyon başına</small>
        </div>
        <div class="pano-kutu">
            <span class="etiket">Komisyon</span>
            <b class="@(ozet.Komisyon > 0 ? "eksi" : "")">@(ozet.Komisyon > 0 ? "−" : "")@Para(ozet.Komisyon)</b>
            <small>platformlara giden</small>
        </div>
        <div class="pano-kutu">
            <span class="etiket">İskonto + ikram</span>
            <b>@Para(ozet.IndirimToplami + ozet.IkramTutari)</b>
            <small>@ozet.IkramAdedi ikram</small>
        </div>
        <div class="pano-kutu">
            <span class="etiket">İptal + iade</span>
            <b>@(ozet.IptalSayisi + ozet.IadeSayisi)</b>
            <small class="@(ozet.IptalTutari + ozet.IadeTutari > 0 ? "eksi" : "")">@Para(ozet.IptalTutari + ozet.IadeTutari) kayıp</small>
        </div>
    </section>

    <section class="pano-izgara ust">
        <div class="pano-kart">
            <div class="kart-baslik">
                <h2>Ödeme</h2>
                <span>toplam @Para(ozet.Ciro)</span>
            </div>
            @if (Model.OdemeKirilimi.Count == 0)
            {
                <p class="pano-bos">Bu gün ödeme yok.</p>
            }
            else
            {
                <div class="odeme-kartlari">
                    @foreach (var odeme in Model.OdemeKirilimi)
                    {
                        <div class="odeme-karti @(odeme == nakit ? "nakit" : "")">
                            <span class="etiket">@odeme.Ad</span>
                            <b>@Para(odeme.Tutar)</b>
                            <small>@odeme.Adet adisyon · %@((ozet.Ciro == 0 ? 0 : odeme.Tutar * 100 / ozet.Ciro).ToString("0", turkce))</small>
                        </div>
                    }
                </div>
                @if (nakit != null)
                {
                    <p class="kasa-notu">Kasada olması gereken nakit: <b>@Para(nakit.Tutar)</b> <small>(sabah kasadaki para hariç)</small></p>
                }
            }
        </div>

        <div class="pano-kart">
            <div class="kart-baslik">
                <h2>Kaynak</h2>
                <span>net · <i class="kirmizi-yazi">kırmızı</i> = komisyon</span>
            </div>
            @await Html.PartialAsync("_PanoKirilim", (Model.KaynakKirilimi, "", true))
        </div>
    </section>

    <section class="pano-izgara alt">
        <div class="pano-kart">
            <div class="kart-baslik">
                <h2>En çok satanlar</h2>
                <span>adet · ciro</span>
            </div>
            @if (Model.EnCokSatanlar.Count == 0)
            {
                <p class="pano-bos">Henüz satış yok.</p>
            }
            else
            {
                <ol class="cok-satan-liste">
                    @for (int sira = 0; sira < Model.EnCokSatanlar.Count; sira++)
                    {
                        var urun = Model.EnCokSatanlar[sira];
                        <li>
                            <span class="sira">@((sira + 1).ToString("00"))</span>
                            <span class="ad">@urun.Ad</span>
                            <b>@urun.Adet</b>
                            <span class="tutar">@urun.Tutar.ToString("N0", turkce) ₺</span>
                        </li>
                    }
                </ol>
            }
        </div>

        @* Günü kapatırken bakılacak kayıplar: hepsi Adisyon panelinde tek tek görülür *@
        <div class="pano-kart">
            <div class="kart-baslik">
                <h2>Kontrol</h2>
                <a asp-controller="Adisyon" asp-action="Index" asp-route-tarih="@Model.Gun.ToString("yyyy-MM-dd")">ayrıntı →</a>
            </div>
            <div class="kontrol-listesi">
                <div><span>İskonto</span><b>@Para(ozet.IndirimToplami)</b></div>
                <div><span>İkram (@ozet.IkramAdedi ürün)</span><b>@Para(ozet.IkramTutari)</b></div>
                <div><span>İptal (@ozet.IptalSayisi adisyon)</span><b>@Para(ozet.IptalTutari)</b></div>
                <div><span>İade (@ozet.IadeSayisi adisyon)</span><b>@Para(ozet.IadeTutari)</b></div>
                <div><span>Adisyondan silinen (@ozet.SilinenUrunAdedi ürün)</span><b>@Para(ozet.SilinenTutar)</b></div>
                <div><span>Hâlâ açık adisyon</span><b>@ozet.AcikSayisi</b></div>
            </div>
            <p class="kasa-alt-not">Rapor ay sonunda e-postayla özet olarak gider.</p>
        </div>
    </section>
</div>
