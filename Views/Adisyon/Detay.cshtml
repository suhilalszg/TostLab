@model AdisyonDetayi
@{
    ViewData["Title"] = $"Adisyon #{Model.Id}";
}

<a class="btn btn-link geri" asp-action="Index" asp-route-tarih="@Model.Acilis.ToString("yyyy-MM-dd")">‹ Adisyon</a>

<div class="detay-izgara">
    <div class="fis kayit-fis">
        <partial name="_Fis" model="FisCiktisi.Detaydan(Model)" />
    </div>

    <div>
        @if (Model.Durum == AdisyonDurumu.Iptal)
        {
            <section class="kart iptal-kart">
                <h2>İptal</h2>
                <p><b>Neden:</b> @Model.IptalNedeni</p>
                <p><b>Eden:</b> @(Model.IptalEden ?? "—") · @Model.Kapanis?.ToString("HH:mm")</p>
            </section>
        }

        @if (Model.Durum == AdisyonDurumu.Iade)
        {
            <section class="kart iptal-kart">
                <h2>İade</h2>
                <p><b>Neden:</b> @Model.IadeNedeni</p>
                <p><b>Eden:</b> @(Model.IadeEden ?? "—") · @Model.IadeSaati?.ToString("HH:mm")</p>
            </section>
        }

        <section class="kart">
            <h2>Silinen ürünler</h2>
            @if (Model.Silinenler.Count == 0)
            {
                <p class="bos-yazi">Bu adisyondan ürün silinmedi.</p>
            }
            else
            {
                <table class="table kayit-tablo">
                    <thead><tr><th>Saat</th><th>Ürün</th><th class="sag">Adet</th><th class="sag">Tutar</th><th>Kim</th></tr></thead>
                    <tbody>
                        @foreach (var iz in Model.Silinenler)
                        {
                            <tr>
                                <td>@iz.Saat.ToString("HH:mm")</td>
                                <td>@iz.UrunAdi</td>
                                <td class="sag">@iz.Adet</td>
                                <td class="sag">@iz.Tutar.ToString("N2")</td>
                                <td>@iz.Kullanici</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
</div>
