@* Pano tarzı kırılım: ad + adet, pay çubuğu, tutar ve yüzde. Ödeme, kaynak ve kategori için ortak.
   KomisyonGoster: çubuğun komisyon kısmı kırmızı, tutar net yazılır (kaynak kırılımı). *@
@model (List<KirilimSatiri> Satirlar, string AdetYazisi, bool KomisyonGoster)
@{
    var turkce = new System.Globalization.CultureInfo("tr-TR");
    var noktali = System.Globalization.CultureInfo.InvariantCulture;
    decimal toplam = Model.Satirlar.Sum(satir => satir.Tutar);
    decimal enBuyuk = Model.Satirlar.Count == 0 ? 1 : Math.Max(1, Model.Satirlar.Max(satir => satir.Tutar));
}
@if (Model.Satirlar.Count == 0)
{
    <p class="pano-bos">Henüz satış yok.</p>
}
else
{
    <div class="kaynak-liste">
        @foreach (var satir in Model.Satirlar)
        {
            decimal net = Model.KomisyonGoster ? satir.Tutar - satir.Komisyon : satir.Tutar;
            decimal pay = toplam == 0 ? 0 : satir.Tutar * 100 / toplam;
            <div class="kaynak-satir genis">
                <span class="ad" title="@satir.Ad">@satir.Ad <small>@satir.Adet @Model.AdetYazisi</small></span>
                <div class="kaynak-cubuk">
                    <div class="net" style="width:@((net * 100 / enBuyuk).ToString("0.##", noktali))%"></div>
                    @if (Model.KomisyonGoster && satir.Komisyon > 0)
                    {
                        <div class="komisyon" style="width:@((satir.Komisyon * 100 / enBuyuk).ToString("0.##", noktali))%"></div>
                    }
                </div>
                <b>@net.ToString("N0", turkce) ₺</b>
                <small class="yuzde">%@pay.ToString("0", turkce)</small>
            </div>
        }
    </div>
}
