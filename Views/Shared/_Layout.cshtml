@{
    // Hangi sayfadayız? Menüde o sayfayı seçili göstermek için
    string aktifSayfa = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string kullaniciAdi = User.Identity?.Name ?? "";
    string basHarf = kullaniciAdi.Length > 0 ? kullaniciAdi.Substring(0, 1).ToUpper() : "?";
    bool yoneticiMi = User.IsInRole(Roller.Yonetici);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TOST LAB</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="panel">
        <aside class="yan-menu">
            <a class="logo" asp-controller="Home" asp-action="Index">TOST LAB°</a>

            <nav>
                <a asp-controller="Home" asp-action="Index" class="@(aktifSayfa == "Home" ? "secili" : "")">Bugün</a>
                @if (yoneticiMi)
                {
                    <a asp-controller="Urunler" asp-action="Index" class="@(aktifSayfa == "Urunler" ? "secili" : "")">Menü</a>
                    <a asp-controller="Kullanicilar" asp-action="Index" class="@(aktifSayfa == "Kullanicilar" ? "secili" : "")">Kullanıcılar</a>
                }
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form class="alt" asp-controller="Giris" asp-action="Cikis" method="post">
                    <div class="rozet" title="@kullaniciAdi">@basHarf</div>
                    <button type="submit" class="cikis">Çıkış</button>
                </form>
            }
        </aside>

        <main class="icerik">
            <div class="ust-bar">
                <h1>@ViewData["Title"]</h1>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="kim">
                        <b>@kullaniciAdi</b> · @(yoneticiMi ? "Yönetici" : "Çalışan")<br />
                        @DateTime.Now.ToString("d MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))
                    </div>
                }
            </div>

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
