@{
    // Hangi sayfadayız? Menüde o sayfayı seçili göstermek için
    string aktifSayfa = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string kullaniciAdi = User.Identity?.Name ?? "";
    string basHarf = kullaniciAdi.Length > 0 ? kullaniciAdi.Substring(0, 1).ToUpper() : "?";
    bool yoneticiMi = User.IsInRole(Roller.Yonetici);
    // Satış ekranı gibi sayfalar başlık çubuğunu istemez: tüm yükseklik onlara kalsın
    bool tamEkran = ViewData["TamEkran"] as bool? ?? false;
    // Tailwind kullanan sayfa Bootstrap istemez: ikisinin aynı adlı sınıfları (p-4, border...) çakışır
    bool bootstrapYok = ViewData["BootstrapYok"] as bool? ?? false;
    // Satış ekranı kendi üst çubuğunu ve menüsünü çizer: soldaki dikey menü gizlenir
    bool menuYok = ViewData["MenuYok"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TOST LAB</title>
    @* Koyu tema yok: program her zaman açık renkte (bilgisayar koyu moddaysa da) *@
    <script>document.documentElement.dataset.tema = 'acik';</script>
    @if (!bootstrapYok)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Stiller", required: false)
</head>
<body>
    <div class="panel @(menuYok ? "menusuz" : "")">
        @if (!menuYok)
        {
        <aside class="yan-menu">
            <a class="logo" asp-controller="Satis" asp-action="Index">TOST LAB°</a>

            <nav>
                <a asp-controller="Satis" asp-action="Index" class="@(aktifSayfa == "Satis" ? "secili" : "")">Satış</a>
                @if (yoneticiMi)
                {
                    <a asp-controller="Adisyon" asp-action="Index" class="@(aktifSayfa == "Adisyon" ? "secili" : "")">Adisyon</a>
                    <a asp-controller="Fisler" asp-action="Index" class="@(aktifSayfa == "Fisler" ? "secili" : "")">Fişler</a>
                    <a asp-controller="Urunler" asp-action="Index" class="@(aktifSayfa == "Urunler" ? "secili" : "")">Menü</a>
                    <a asp-controller="Ayarlar" asp-action="Index" class="@(aktifSayfa == "Ayarlar" ? "secili" : "")">Ayarlar</a>
                    <a asp-controller="Kullanicilar" asp-action="Index" class="@(aktifSayfa == "Kullanicilar" ? "secili" : "")">Kullanıcılar</a>
                }
            </nav>

            <div class="alt">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Giris" asp-action="Cikis" method="post" class="cikis-formu">
                        <div class="rozet" title="@kullaniciAdi">@basHarf</div>
                        <button type="submit" class="cikis">Çıkış</button>
                    </form>
                }
            </div>
        </aside>
        }

        <main class="icerik @(tamEkran ? "tam-ekran" : "")">
            @if (!tamEkran && !(ViewData["UstBarYok"] as bool? ?? false))
            {
                <div class="ust-bar">
                    <h1>@ViewData["Title"]</h1>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="kim">
                            <b>@kullaniciAdi</b> · @(yoneticiMi ? "Yönetici" : "Çalışan")<br />
                            @DateTime.Now.ToString("d MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))
                        </div>
                    }
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @if (!bootstrapYok)
    {
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
