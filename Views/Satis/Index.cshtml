@using System.Text.Json
@{
    ViewData["Title"] = "Satış";
    ViewData["TamEkran"] = true;
    ViewData["BootstrapYok"] = true;
    ViewData["MenuYok"] = true;   // bu ekran kendi üst çubuğunu ve menüsünü çizer

    // Sunucudaki veriyi ekrana JSON olarak gömüyoruz: sayfa açılır açılmaz hazır, ekstra istek yok.
    // JsonSerializer < > karakterlerini kaçırır, yani ürün adı ne olursa olsun güvenli.
    var jsonAyari = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    string baslangicVerisi = JsonSerializer.Serialize(new
    {
        urunler = ViewData["Urunler"],
        odemeTurleri = ViewData["OdemeTurleri"],
        ekran = ViewData["Ekran"],
        platformlar = ViewData["Platformlar"]
    }, jsonAyari);

    string kullaniciAdi = User.Identity?.Name ?? "";
    bool yoneticiMi = User.IsInRole(Roller.Yonetici);

    // Tekrar eden görünümler (Tailwind sınıfları)
    const string islemDugmesi = "w-full flex flex-col items-center justify-center gap-1 py-3 text-[11px] font-bold tracking-wide text-white/95 hover:bg-white/10 cursor-pointer select-none active:scale-95 transition disabled:opacity-35 disabled:cursor-not-allowed disabled:active:scale-100 border-b border-white/15";
    const string sagCubukDugme = "relative w-full py-3.5 pl-4 pr-3 text-left text-[13px] font-extrabold uppercase tracking-wide cursor-pointer select-none transition";
    const string sadeDugme = "rounded-xl py-3 px-4 font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer select-none active:scale-95 transition";
    const string anaDugme = "rounded-xl py-3 px-4 font-bold text-[#F2C230] bg-[#141414] hover:bg-black shadow-md cursor-pointer select-none active:scale-95 transition disabled:opacity-60";
    const string kutu = "w-full rounded-xl border border-slate-200 bg-white py-3 px-4 outline-none focus:ring-2 focus:ring-amber-400";
}

@section Stiller {
    <style>
        @@font-face { font-family: 'Inter'; font-style: normal; font-weight: 100 900; font-display: swap;
            src: url('/fonts/inter-latin-ext.woff2') format('woff2');
            unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
        @@font-face { font-family: 'Inter'; font-style: normal; font-weight: 100 900; font-display: swap;
            src: url('/fonts/inter-latin.woff2') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
        [x-cloak] { display: none !important; }
        .kaydirma-yok::-webkit-scrollbar { display: none; }
        .kaydirma-yok { scrollbar-width: none; }
        .ince-kaydirma::-webkit-scrollbar { width: 6px; }
        .ince-kaydirma::-webkit-scrollbar-thumb { background: rgba(0, 0, 0, .18); border-radius: 9px; }
        /* Sağ çubukta seçili sekme: içerik alanına doğru taşan beyaz "dil" */
        .secili-sekme { background: #F3F2EE; color: #141414; margin-left: -14px; padding-left: 30px; border-radius: 999px 0 0 999px; }
        .secili-sekme::before, .secili-sekme::after { content: ""; position: absolute; right: 0; width: 16px; height: 16px; background: transparent; }
        .secili-sekme::before { top: -16px; border-bottom-right-radius: 16px; box-shadow: 6px 6px 0 6px #F3F2EE; }
        .secili-sekme::after { bottom: -16px; border-top-right-radius: 16px; box-shadow: 6px -6px 0 6px #F3F2EE; }
    </style>
    @* Tailwind: internetsiz çalışsın diye yerel kopya (wwwroot/lib/tailwindcss) *@
    <script src="~/lib/tailwindcss/tailwind.js"></script>
    <script>
        tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'system-ui', 'Segoe UI', 'sans-serif'] } } } };
    </script>
}

@Html.AntiForgeryToken()
<script type="application/json" id="satis-verisi">@Html.Raw(baslangicVerisi)</script>

<div class="h-screen flex flex-col bg-[#141414] text-slate-800 font-sans antialiased"
     x-data="satisEkrani" x-cloak @@keydown.escape.window="geriDon()" data-pos>

    @* ===================== ÜST ÇUBUK ===================== *@
    <header class="relative z-30 shrink-0 h-[60px] flex items-center gap-4 px-4 text-white">
        <button type="button" x-show="gorunum === 'satis'" @@click="geriDon()" aria-label="Masalara dön"
                class="h-9 w-9 grid place-items-center rounded-lg bg-white/15 hover:bg-white/25 cursor-pointer active:scale-95 transition">
            @Simge("geri", "h-5 w-5")
        </button>
        <div class="relative" @@click.outside="menuAcik = false">
            <button type="button" @@click="menuAcik = !menuAcik" class="flex items-baseline gap-2 cursor-pointer">
                <span class="text-[22px] font-black tracking-[.18em] text-[#F2C230]">TOST LAB°</span>
                <span class="text-[13px] font-semibold text-white/75">▾</span>
            </button>
            <div x-show="menuAcik" x-transition.origin.top.left
                 class="absolute left-0 top-11 w-60 rounded-2xl bg-white text-slate-700 shadow-2xl ring-1 ring-black/5 p-2">
                @if (yoneticiMi)
                {
                    <a href="/Adisyon" class="block rounded-xl px-4 py-3 font-semibold hover:bg-amber-50">Adisyon</a>
                    <a href="/Fisler" class="block rounded-xl px-4 py-3 font-semibold hover:bg-amber-50">Fişler</a>
                    <a href="/Urunler" class="block rounded-xl px-4 py-3 font-semibold hover:bg-amber-50">Menü ve fotoğraflar</a>
                    <a href="/Ayarlar" class="block rounded-xl px-4 py-3 font-semibold hover:bg-amber-50">Ayarlar</a>
                    <a href="/Kullanicilar" class="block rounded-xl px-4 py-3 font-semibold hover:bg-amber-50">Kullanıcılar</a>
                }
                <div class="my-2 h-px bg-slate-100"></div>
                <form method="post" action="/Giris/Cikis">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full text-left rounded-xl px-4 py-3 font-semibold text-rose-600 hover:bg-rose-50 cursor-pointer">Çıkış yap</button>
                </form>
            </div>
        </div>
        <span class="text-[13px] font-extrabold uppercase tracking-widest text-white/90 border-l border-white/30 pl-4" x-text="gorunum === 'plan' ? 'Masalar' : 'Sipariş'"></span>

        <div class="ml-auto flex items-center gap-6 text-[11px] font-bold uppercase">
            <span class="flex items-center gap-2" :title="internetVar ? 'İnternet bağlı' : 'İnternet yok (program yine çalışır)'">
                @Simge("wifi", "h-5 w-5")
                <span class="leading-tight">İnternet<br /><span class="font-semibold text-[10px]" :class="internetVar ? 'text-white/70' : 'text-yellow-200'" x-text="internetVar ? 'Bağlı' : 'Yok'"></span></span>
            </span>
            <span class="flex items-center gap-2" :title="sunucuVar ? 'Sunucu cevap veriyor' : 'Sunucuya ulaşılamıyor'">
                @Simge("sunucu", "h-5 w-5")
                <span class="leading-tight">Server<br /><span class="font-semibold text-[10px]" :class="sunucuVar ? 'text-white/70' : 'text-yellow-200'" x-text="sunucuVar ? 'Bağlı' : 'Yok'"></span></span>
            </span>
            <span class="text-white/80" x-show="bekleyenIstek > 0" title="Kaydediliyor">@DonenSimge("h-4 w-4")</span>
            <span class="text-base font-black tabular-nums normal-case" x-text="saatYazisi"></span>
            <span class="flex items-center gap-2">
                @Simge("kisi", "h-5 w-5")
                <span class="leading-tight normal-case text-[12px]">@kullaniciAdi<br /><span class="font-semibold text-[10px] uppercase text-white/70">@(yoneticiMi ? "Yönetici" : "Çalışan")</span></span>
            </span>
        </div>
    </header>

    @* ===================== 1) MASA PLANI ===================== *@
    <section class="flex-1 min-h-0 flex mx-3 mb-3 rounded-2xl overflow-hidden shadow-2xl" x-show="gorunum === 'plan'">

        @* Sol: açık adisyonlar + toplam *@
        <aside class="w-[300px] shrink-0 flex flex-col bg-white border-r border-slate-100">
            <div class="h-14 px-5 flex items-center justify-between border-b border-slate-100">
                <h2 class="font-extrabold text-[#9A7400]">Açık adisyonlar</h2>
                <span class="h-6 min-w-6 px-2 rounded-full bg-[#F2C230] text-[#141414] text-xs font-bold grid place-items-center" x-text="acikListe.length"></span>
            </div>
            <div class="flex-1 min-h-0 overflow-y-auto ince-kaydirma">
                <template x-for="oge in acikListe" :key="oge.anahtar">
                    <button type="button" @@click="acikListeAc(oge)"
                            class="w-full text-left flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 hover:bg-amber-50/60 cursor-pointer select-none transition">
                        <span class="flex-1 min-w-0">
                            <span class="block font-bold text-slate-800 truncate" x-text="oge.baslik"></span>
                            <span class="block text-xs text-slate-400 truncate" x-text="[oge.garson, gecenSure(oge.acilis)].filter(Boolean).join(' · ')"></span>
                        </span>
                        <span class="font-semibold tabular-nums text-slate-600" x-text="para(oge.toplam)"></span>
                    </button>
                </template>
                <p class="px-5 py-12 text-center text-sm text-slate-400" x-show="!acikListe.length">Açık adisyon yok.</p>
            </div>
            <div class="px-5 py-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Toplam</span>
                <span class="text-[26px] font-black tabular-nums text-[#141414]" x-text="para(acikToplam)"></span>
            </div>
        </aside>

        @* Orta: masalar + paketler *@
        <div class="flex-1 min-w-0 overflow-y-auto ince-kaydirma bg-[#F3F2EE] p-5 space-y-7">
            <div x-show="planFiltresi !== 'paket'">
                <div class="text-sm font-semibold text-slate-500 mb-3">Salon <span class="text-slate-300 mx-1">›</span> <span class="text-[#141414]" x-text="planSuzgecleri.find(s => s.kod === planFiltresi).ad"></span></div>
                <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(170px,1fr))]">
                    <template x-for="masa in gorunenMasalar" :key="masa.id">
                        <button type="button" @@click="masaAc(masa)"
                                class="relative text-left rounded-2xl p-4 min-h-[128px] flex flex-col justify-between cursor-pointer select-none active:scale-95 transition-all duration-200 hover:-translate-y-0.5 shadow-sm hover:shadow-lg"
                                :class="masa.doluMu ? 'text-white bg-[#141414]' : 'bg-white text-slate-700'">
                            <div class="flex items-start justify-between gap-2">
                                <span class="text-[17px] font-extrabold" x-text="masa.ad"></span>
                                <span class="h-6 min-w-6 px-1.5 rounded-full text-xs font-bold grid place-items-center" x-show="masa.kisiSayisi"
                                      :class="masa.doluMu ? 'bg-white text-[#9A7400]' : 'bg-amber-100 text-[#9A7400]'" x-text="masa.kisiSayisi" title="Kişi sayısı"></span>
                            </div>
                            <template x-if="!masa.doluMu">
                                <span class="text-sm font-semibold text-emerald-500">Boş</span>
                            </template>
                            <template x-if="masa.doluMu">
                                <div>
                                    <div class="text-[22px] font-black tabular-nums text-[#F2C230]" x-text="para(masa.toplam)"></div>
                                    <div class="flex items-center justify-between gap-2 text-xs font-semibold text-white/85">
                                        <span class="inline-flex items-center gap-1 truncate">@Simge("kisi", "h-3.5 w-3.5")<span x-text="masa.garson ?? '—'"></span></span>
                                        <span class="inline-flex items-center gap-1 shrink-0">@Simge("saat", "h-3.5 w-3.5")<span x-text="gecenSure(masa.acilis)"></span></span>
                                    </div>
                                </div>
                            </template>
                        </button>
                    </template>
                </div>
                <p class="py-16 text-center text-slate-400" x-show="!gorunenMasalar.length">Bu süzgeçte masa yok.</p>
            </div>

            <div x-show="planFiltresi === 'tum' || planFiltresi === 'paket'">
                <div class="text-sm font-semibold text-slate-500 mb-3">Paket ve online</div>
                <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(190px,1fr))]" x-show="ekran.paketler.length">
                    <template x-for="paket in ekran.paketler" :key="paket.adisyonId">
                        <button type="button" @@click="adisyonAc(paket.adisyonId, paket.baslik, paket.kaynak)"
                                class="text-left bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-200 p-4 flex flex-col gap-2 cursor-pointer select-none active:scale-95">
                            <div class="flex items-center justify-between gap-2">
                                <span class="rounded-full px-2.5 py-0.5 text-xs font-bold text-white" :class="platformDugmeRengi(paket.kaynak)" x-text="paket.kaynak"></span>
                                <span class="text-sm font-semibold tabular-nums text-slate-400" x-text="saat(paket.acilis)"></span>
                            </div>
                            <div class="text-[22px] font-black tabular-nums text-slate-800" x-text="para(paket.toplam)"></div>
                            <div class="flex items-center justify-between text-xs text-slate-400">
                                <span x-text="paket.garson ?? ''"></span>
                                <span class="inline-flex items-center gap-1">@Simge("saat", "h-3.5 w-3.5")<span x-text="gecenSure(paket.acilis)"></span></span>
                            </div>
                        </button>
                    </template>
                </div>
                <p class="text-sm text-slate-400" x-show="!ekran.paketler.length">Açık paket yok. Sağdan yeni sipariş başlat.</p>
            </div>
        </div>

        @* Sağ: süzgeçler + yeni sipariş *@
        <nav class="w-[190px] shrink-0 flex flex-col bg-[#141414] text-white py-4 overflow-y-auto kaydirma-yok">
            <div class="px-5 pb-2 text-[11px] font-bold uppercase tracking-[.2em] text-white/50">Salon</div>
            <template x-for="suzgec in planSuzgecleri" :key="suzgec.kod">
                <button type="button" @@click="planFiltresi = suzgec.kod" class="@sagCubukDugme"
                        :class="planFiltresi === suzgec.kod ? 'secili-sekme' : 'hover:bg-white/10'">
                    <span x-text="suzgec.ad"></span>
                    <span class="ml-1 text-[11px] font-bold opacity-60" x-text="'(' + suzgec.sayi + ')'"></span>
                </button>
            </template>
            <div class="px-5 pt-5 pb-2 text-[11px] font-bold uppercase tracking-[.2em] text-white/50">Yeni sipariş</div>
            <div class="px-3 space-y-2">
                <template x-for="kaynak in paketKaynaklari" :key="kaynak">
                    <button type="button" @@click="paketAc(kaynak)" x-text="'+ ' + kaynak"
                            class="w-full rounded-xl py-2.5 px-3 text-sm font-bold text-white text-left cursor-pointer select-none active:scale-95 transition hover:brightness-110"
                            :class="platformDugmeRengi(kaynak)"></button>
                </template>
            </div>
            <button type="button" @@click="iadeAc()" class="mt-auto mx-3 rounded-xl py-3 text-sm font-bold bg-white/10 hover:bg-white/20 cursor-pointer select-none active:scale-95 transition inline-flex items-center justify-center gap-2">
                @Simge("iade", "h-4 w-4") İade
            </button>
        </nav>
    </section>

    @* ===================== 2) SATIŞ ===================== *@
    <section class="flex-1 min-h-0 flex mx-3 mb-3 rounded-2xl overflow-hidden shadow-2xl" x-show="gorunum === 'satis'">

        @* Sol: işlem çubuğu (pembe) *@
        <nav class="w-[78px] shrink-0 flex flex-col bg-[#1f1f1f] overflow-y-auto kaydirma-yok">
            <button type="button" @@click="paketAc('Paket')" class="@islemDugmesi">@Simge("arti", "h-6 w-6")Yeni</button>
            <button type="button" @@click="ikramAc()" :disabled="platformMu" class="@islemDugmesi">@Simge("ikram", "h-6 w-6")İkram</button>
            <button type="button" @@click="iadeAc()" class="@islemDugmesi">@Simge("iade", "h-6 w-6")İade</button>
            <button type="button" @@click="bolAc()" :disabled="platformMu" class="@islemDugmesi">@Simge("bol", "h-6 w-6")Böl</button>
            <button type="button" @@click="indirimAc()" :disabled="platformMu" class="@islemDugmesi">@Simge("iskonto", "h-6 w-6")İskonto</button>
            <button type="button" @@click="iptalAc()" class="@islemDugmesi">@Simge("iptal", "h-6 w-6")İptal</button>
            <button type="button" @@click="tasiAc()" :disabled="platformMu" class="@islemDugmesi">@Simge("tasi", "h-6 w-6")Taşı</button>
        </nav>

        @* Adisyon (beyaz) *@
        <aside class="w-[340px] shrink-0 flex flex-col bg-white border-r border-slate-100">
            <div class="h-16 px-4 flex items-center gap-2.5 border-b border-slate-100">
                <span class="h-7 min-w-7 px-1.5 rounded-full bg-[#F2C230] text-[#141414] text-[13px] font-bold grid place-items-center"
                      x-show="secili.kaynak === 'Masa'" x-text="kisiSayisi ?? '–'" title="Kişi sayısı"></span>
                <h2 class="min-w-0 flex-1 truncate text-[17px] font-extrabold text-[#141414]" x-text="secili.baslik"></h2>
                <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-bold text-white" x-show="secili.kaynak !== 'Masa'"
                      :class="platformDugmeRengi(secili.kaynak)" x-text="secili.kaynak"></span>
                <span class="shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-[#141414] text-white text-xs font-bold px-2.5 py-1.5" x-show="adisyon?.garson">
                    @Simge("kisi", "h-3.5 w-3.5")<span x-text="adisyon?.garson"></span>
                </span>
            </div>
            <div class="px-4 py-2 flex items-center justify-between text-xs text-slate-400 border-b border-slate-100" x-show="secili.kaynak === 'Masa' || adisyon">
                <span x-text="adisyon ? 'Açılış ' + saat(adisyon.acilis) + ' · ' + gecenSure(adisyon.acilis) : 'Yeni adisyon'"></span>
                <span class="inline-flex items-center gap-1" x-show="secili.kaynak === 'Masa'">
                    Kişi
                    <button type="button" @@click="kisiDegistir(-1)" aria-label="Kişi azalt" class="h-7 w-7 rounded-md bg-slate-100 hover:bg-slate-200 font-bold text-slate-600 cursor-pointer">−</button>
                    <button type="button" @@click="kisiDegistir(1)" aria-label="Kişi arttır" class="h-7 w-7 rounded-md bg-slate-100 hover:bg-slate-200 font-bold text-slate-600 cursor-pointer">+</button>
                </span>
            </div>

            @* Satırlar: dokununca adet düğmeleri açılır *@
            <div class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden ince-kaydirma">
                <div class="flex items-center justify-center gap-3 py-12 text-slate-400" x-show="adisyonYukleniyor">
                    @DonenSimge("h-6 w-6") <span>Adisyon yükleniyor…</span>
                </div>
                <template x-for="satir in satirlar" :key="satir.anahtar">
                    <div class="px-4 border-b border-slate-100 transition-colors" :class="[seciliSatir === satir.anahtar ? 'bg-amber-50/70' : '', !satir.id ? 'opacity-60' : '']">
                        <button type="button" @@click="seciliSatir = seciliSatir === satir.anahtar ? null : satir.anahtar"
                                class="w-full flex items-center gap-3 py-3.5 text-left cursor-pointer select-none">
                            <span class="w-8 shrink-0 font-bold text-[#9A7400] tabular-nums" x-text="satir.adet + 'x'"></span>
                            <span class="flex-1 min-w-0 font-semibold text-slate-700 leading-snug">
                                <span x-text="satir.ad"></span>
                                <span class="ml-1 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold text-[#9A7400] align-middle" x-show="satir.ikramMi">İKRAM</span>
                            </span>
                            <span class="tabular-nums text-slate-600" :class="satir.ikramMi ? 'line-through text-slate-300' : ''" x-text="para(satir.adet * satir.birimFiyat)"></span>
                        </button>
                        <div class="flex items-center gap-2 pb-3 pl-11" x-show="seciliSatir === satir.anahtar" x-transition.opacity>
                            <button type="button" @@click="azalt(satir)" :disabled="!satir.id" aria-label="Azalt"
                                    class="h-9 w-11 rounded-lg bg-white border border-slate-200 text-lg font-bold text-slate-600 hover:border-amber-300 cursor-pointer active:scale-95 disabled:opacity-40">−</button>
                            <button type="button" @@click="arttir(satir)" :disabled="satir.ikramMi" aria-label="Arttır"
                                    class="h-9 w-11 rounded-lg bg-white border border-slate-200 text-lg font-bold text-slate-600 hover:border-amber-300 cursor-pointer active:scale-95 disabled:opacity-40">+</button>
                            <span class="text-xs text-slate-400 tabular-nums" x-text="satir.ikramMi ? '' : para(satir.birimFiyat) + ' / adet'"></span>
                            <button type="button" @@click="sil(satir)" :disabled="!satir.id"
                                    class="ml-auto h-9 px-3 rounded-lg text-sm font-bold text-rose-600 hover:bg-rose-50 cursor-pointer active:scale-95 disabled:opacity-40">Sil</button>
                        </div>
                    </div>
                </template>
                <div class="py-16 text-center text-slate-400" x-show="!satirlar.length && !adisyonYukleniyor">
                    <div class="mx-auto mb-3 h-14 w-14 rounded-2xl grid place-items-center bg-amber-50 text-[#9A7400]">@Simge("fis", "h-7 w-7")</div>
                    Adisyon boş. Ürüne dokun.
                </div>
            </div>

            <div class="border-t border-slate-100 px-4 pt-3 pb-4 space-y-2">
                <div class="space-y-1 text-sm" x-show="ikramTutari > 0 || indirimTutari > 0">
                    <div class="flex justify-between text-slate-400"><span>Ara toplam</span><span class="tabular-nums" x-text="para(araToplam)"></span></div>
                    <div class="flex justify-between text-[#9A7400] font-semibold" x-show="ikramTutari > 0"><span>İkram</span><span class="tabular-nums" x-text="'−' + para(ikramTutari)"></span></div>
                    <div class="flex justify-between text-[#141414] font-semibold" x-show="indirimTutari > 0">
                        <span x-text="'İskonto' + (adisyon?.indirim?.yuzdeMi ? ' %' + adisyon.indirim.deger : '') + (adisyon?.indirim?.neden ? ' · ' + adisyon.indirim.neden : '')"></span>
                        <span class="tabular-nums" x-text="'−' + para(indirimTutari)"></span>
                    </div>
                </div>
                <div class="flex items-center gap-3 pt-1">
                    <button type="button" @@click="odemeyiAc()" :disabled="odeniyor"
                            class="inline-flex items-center justify-center gap-2 rounded-xl py-3.5 px-6 text-[15px] font-extrabold uppercase tracking-wide text-[#141414] bg-[#F2C230] shadow-md shadow-black/10 hover:brightness-105 cursor-pointer select-none active:scale-95 transition disabled:opacity-70">
                        <span x-show="odeniyor">@DonenSimge("h-5 w-5")</span>
                        <span x-text="platformMu ? 'Kapat' : 'Ödeme al'"></span>
                    </button>
                    <b class="ml-auto text-[28px] font-black tabular-nums text-[#141414]" x-text="para(toplam)"></b>
                </div>
            </div>
        </aside>

        @* Ürünler (açık zemin, beyaz kartlar) *@
        <div class="flex-1 min-w-0 flex flex-col bg-[#F3F2EE]">
            <div class="h-14 shrink-0 flex items-center gap-3 px-5">
                <div class="text-sm font-semibold text-slate-500 truncate">
                    Menüler <span class="text-slate-300 mx-1">›</span>
                    <span class="text-[#141414]" x-text="arama ? 'Arama: ' + arama : seciliKategori"></span>
                </div>
                <label class="ml-auto relative w-56 max-w-[45%]">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">@Simge("ara", "h-4 w-4")</span>
                    <input type="search" placeholder="Ara" x-model="arama" autocomplete="off"
                           class="w-full rounded-full bg-white text-[#141414] placeholder-slate-400 border border-slate-200 py-2 pl-9 pr-4 text-sm font-semibold outline-none focus:ring-2 focus:ring-amber-400" />
                </label>
            </div>
            <div class="flex-1 min-h-0 overflow-y-auto ince-kaydirma px-5 pb-5">
                <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(148px,1fr))]">
                    <template x-for="urun in gorunenUrunler" :key="urun.id">
                        <button type="button" @@click="urunEkle(urun)" :disabled="urun.fiyat <= 0"
                                class="relative text-left rounded-xl bg-white p-2 shadow-[0_2px_10px_rgba(60,20,110,.08)] hover:shadow-[0_8px_24px_rgba(60,20,110,.16)] flex flex-col cursor-pointer select-none active:scale-95 transition-all duration-200 disabled:cursor-not-allowed disabled:active:scale-100"
                                :class="adisyondakiAdet(urun.id) ? 'ring-2 ring-[#F2C230]' : ''">
                            <div class="relative aspect-[4/3] w-full rounded-lg overflow-hidden bg-slate-100">
                                @* İçecek fotoğrafları uzun şişe/kutu: kesilmesin diye beyaz zeminde bütün görünür *@
                                <img :src="gorsel(urun)" alt="" loading="lazy" class="h-full w-full"
                                     :class="gorsel(urun).includes('/icecek-') ? 'object-contain bg-white p-1' : 'object-cover'" />
                                <div x-show="urun.fiyat <= 0" class="absolute inset-0 grid place-items-center bg-black/70 text-white text-center text-sm font-bold leading-tight">Fiyat<br />girilmedi</div>
                            </div>
                            <span class="mt-2 px-1 text-[13px] font-semibold text-slate-800 leading-snug min-h-[2.4em]" x-text="urun.ad"></span>
                            <span class="px-1 pb-0.5 text-[14px] font-bold tabular-nums text-[#9A7400]" x-text="urun.fiyat > 0 ? para(urun.fiyat) : ''"></span>
                            <span x-show="adisyondakiAdet(urun.id)" x-text="adisyondakiAdet(urun.id)"
                                  class="absolute -top-2 -right-2 min-w-7 h-7 px-1.5 rounded-full bg-[#F2C230] text-[#141414] text-sm font-black grid place-items-center shadow-lg"></span>
                        </button>
                    </template>
                </div>
                <p class="py-12 text-center text-slate-400" x-show="!gorunenUrunler.length">Ürün bulunamadı.</p>
            </div>
        </div>

        @* Sağ: kategoriler (koyu mor, seçili olan beyaz dil) *@
        <nav class="w-[190px] shrink-0 flex flex-col bg-[#141414] text-white py-4 overflow-y-auto kaydirma-yok">
            <div class="px-5 pb-3 text-[11px] font-bold uppercase tracking-[.2em] text-white/50">Menüler</div>
            <template x-for="kategori in kategoriler" :key="kategori">
                <button type="button" @@click="seciliKategori = kategori; arama = ''" x-text="kategori" class="@sagCubukDugme leading-tight"
                        :class="kategori === seciliKategori && !arama ? 'secili-sekme' : 'hover:bg-white/10'"></button>
            </template>
        </nav>
    </section>

    @* ===================== PENCERELER ===================== *@
    <div class="fixed inset-0 z-40 bg-black/55 backdrop-blur-sm grid place-items-center p-4"
         x-show="pencere" x-transition.opacity @@click.self="pencereyiKapat()">
        <div class="w-full max-w-lg max-h-[88vh] flex flex-col rounded-2xl bg-white shadow-2xl overflow-hidden" x-show="pencere" x-transition.scale.95>
            <div class="shrink-0 flex items-center justify-between px-5 py-4 text-[#F2C230] bg-[#141414]">
                <h3 class="text-lg font-extrabold" x-text="pencereBasligi"></h3>
                <button type="button" @@click="pencereyiKapat()" aria-label="Kapat" class="h-9 w-9 rounded-lg bg-white/15 hover:bg-white/25 text-xl cursor-pointer">×</button>
            </div>

            <div class="flex-1 min-h-0 overflow-y-auto ince-kaydirma p-5">

                @* --- Ödeme --- *@
                <div class="space-y-4" x-show="pencere === 'odeme'">
                    <div class="text-center">
                        <div class="text-xs font-bold uppercase tracking-widest text-slate-400" x-text="secili.baslik"></div>
                        <div class="text-4xl font-black tabular-nums text-[#141414]" x-text="para(toplam)"></div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <template x-for="odeme in odemeTurleri" :key="odeme.id">
                            <button type="button" @@click="ode(odeme)" :disabled="odeniyor"
                                    class="inline-flex items-center justify-center gap-2 rounded-xl py-5 px-4 font-bold text-slate-700 bg-slate-50 border-2 border-slate-100 hover:border-[#22a650] hover:text-[#22a650] cursor-pointer select-none active:scale-95 transition disabled:opacity-60">
                                <span x-show="odeniyor === odeme.id">@DonenSimge("h-5 w-5")</span>
                                <span x-text="odeme.ad"></span>
                            </button>
                        </template>
                    </div>
                </div>

                @* --- İptal --- *@
                <form class="space-y-3" x-show="pencere === 'iptal'" @@submit.prevent="iptalEt()">
                    <p class="text-sm text-slate-500">Adisyonun tamamı iptal edilir. Nedeni Adisyon panelinde görünür.</p>
                    <div class="flex flex-wrap gap-2">
                        <template x-for="neden in hazirIptalNedenleri" :key="neden">
                            <button type="button" @@click="iptalNedeni = neden" x-text="neden"
                                    class="rounded-full px-3 py-1.5 text-sm font-semibold cursor-pointer transition"
                                    :class="iptalNedeni === neden ? 'bg-rose-600 text-white' : 'bg-rose-50 text-rose-700'"></button>
                        </template>
                    </div>
                    <input type="text" x-model="iptalNedeni" x-ref="iptalNedeni" maxlength="200" placeholder="İptal nedeni" class="@kutu" />
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" @@click="pencereyiKapat()" class="@sadeDugme">Vazgeç</button>
                        <button type="submit" class="rounded-xl py-3 px-4 font-bold bg-rose-600 text-white hover:bg-rose-700 cursor-pointer select-none active:scale-95 transition">İptal et</button>
                    </div>
                </form>

                @* --- İskonto --- *@
                <form class="space-y-3" x-show="pencere === 'indirim'" @@submit.prevent="indirimUygula()">
                    <div class="grid grid-cols-4 gap-2">
                        <template x-for="yuzde in [5, 10, 15, 20]" :key="yuzde">
                            <button type="button" @@click="indirimUygula(yuzde)" x-text="'%' + yuzde"
                                    class="rounded-xl py-4 font-black text-[#141414] bg-amber-50 hover:bg-amber-100 cursor-pointer select-none active:scale-95 transition"></button>
                        </template>
                    </div>
                    <div class="flex gap-2">
                        <div class="inline-flex rounded-xl border border-slate-200 overflow-hidden shrink-0">
                            <button type="button" @@click="indirimFormu.yuzdeMi = true" class="px-4 font-bold cursor-pointer" :class="indirimFormu.yuzdeMi ? 'bg-[#141414] text-white' : ''">%</button>
                            <button type="button" @@click="indirimFormu.yuzdeMi = false" class="px-4 font-bold cursor-pointer" :class="!indirimFormu.yuzdeMi ? 'bg-[#141414] text-white' : ''">₺</button>
                        </div>
                        <input type="text" inputmode="decimal" x-model="indirimFormu.deger" x-ref="indirimDegeri" placeholder="Değer" class="@kutu tabular-nums min-w-0" />
                    </div>
                    <input type="text" x-model="indirimFormu.neden" maxlength="100" placeholder="Neden (isteğe bağlı) örn. tanıdık, öğrenci" class="@kutu" />
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" x-show="adisyon?.indirim" @@click="indirimKaldir()" class="rounded-xl py-3 px-4 font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 cursor-pointer select-none active:scale-95 transition">Kaldır</button>
                        <button type="button" x-show="!adisyon?.indirim" @@click="pencereyiKapat()" class="@sadeDugme">Vazgeç</button>
                        <button type="submit" class="@anaDugme">Uygula</button>
                    </div>
                </form>

                @* --- İkram --- *@
                <div class="space-y-2" x-show="pencere === 'ikram'">
                    <p class="text-sm text-slate-500 mb-2">İkram edilen ürün adisyonda kalır ama ücreti alınmaz.</p>
                    <template x-for="satir in (adisyon?.satirlar ?? [])" :key="'ik' + satir.id">
                        <div class="flex items-center gap-3 rounded-xl px-4 py-3 bg-slate-50">
                            <div class="flex-1 min-w-0">
                                <div class="font-semibold truncate" x-text="satir.adet + 'x ' + satir.ad"></div>
                                <div class="text-xs" :class="satir.ikramMi ? 'text-[#9A7400] font-bold' : 'text-slate-400'" x-text="satir.ikramMi ? 'İKRAM' : para(satir.adet * satir.birimFiyat)"></div>
                            </div>
                            <template x-if="!satir.ikramMi">
                                <div class="flex gap-2">
                                    <button type="button" x-show="satir.adet > 1" @@click="ikramEt(satir, 1)" class="rounded-lg py-2 px-3 text-sm font-bold bg-white border border-amber-300 text-[#9A7400] cursor-pointer active:scale-95 transition">1 tane</button>
                                    <button type="button" @@click="ikramEt(satir, null)" class="rounded-lg py-2 px-3 text-sm font-bold text-[#141414] bg-[#F2C230] cursor-pointer active:scale-95 transition" x-text="satir.adet > 1 ? 'Hepsi' : 'İkram et'"></button>
                                </div>
                            </template>
                            <template x-if="satir.ikramMi">
                                <button type="button" @@click="ikramEt(satir, null)" class="rounded-lg py-2 px-3 text-sm font-bold bg-white border border-slate-200 text-slate-600 cursor-pointer active:scale-95 transition">Geri al</button>
                            </template>
                        </div>
                    </template>
                </div>

                @* --- Taşı --- *@
                <div class="space-y-3" x-show="pencere === 'tasi'">
                    <p class="text-sm text-slate-500">Hedef masayı seç. Masa doluysa iki adisyon birleşir.</p>
                    <div class="grid grid-cols-3 gap-3">
                        <template x-for="masa in ekran.masalar.filter(masa => masa.id !== secili.masaId)" :key="'t' + masa.id">
                            <button type="button" @@click="tasi(masa)" class="rounded-xl p-3 min-h-[72px] text-left font-bold cursor-pointer select-none active:scale-95 transition"
                                    :class="masa.doluMu ? 'text-white bg-[#141414]' : 'bg-slate-50 border-2 border-slate-100 text-slate-700 hover:border-amber-300'">
                                <span class="block" x-text="masa.ad"></span>
                                <span class="block text-xs font-semibold opacity-80" x-text="masa.doluMu ? 'Birleştir · ' + para(masa.toplam) : 'Boş'"></span>
                            </button>
                        </template>
                    </div>
                </div>

                @* --- Böl --- *@
                <div class="space-y-3" x-show="pencere === 'bol'">
                    <p class="text-sm text-slate-500">Ödenecek ürünleri seç; kalanı masada açık kalır.</p>
                    <template x-for="satir in (adisyon?.satirlar ?? [])" :key="'b' + satir.id">
                        <div class="flex items-center gap-3 rounded-xl px-4 py-2.5 bg-slate-50">
                            <div class="flex-1 min-w-0">
                                <div class="font-semibold truncate" x-text="satir.ad"></div>
                                <div class="text-xs text-slate-400" x-text="(satir.ikramMi ? 'İKRAM' : para(satir.birimFiyat)) + ' · ' + satir.adet + ' adet'"></div>
                            </div>
                            <div class="flex items-center rounded-lg bg-white border border-slate-200">
                                <button type="button" @@click="bolDegistir(satir, -1)" class="h-10 w-10 text-xl font-bold cursor-pointer active:scale-95">−</button>
                                <b class="w-7 text-center tabular-nums" x-text="bolSecimi[satir.id] ?? 0"></b>
                                <button type="button" @@click="bolDegistir(satir, 1)" class="h-10 w-10 text-xl font-bold cursor-pointer active:scale-95">+</button>
                            </div>
                        </div>
                    </template>
                    <div class="flex items-center justify-between pt-2">
                        <button type="button" @@click="bolHepsi()" class="text-sm font-semibold text-[#141414] cursor-pointer">Hepsini seç / temizle</button>
                        <div class="text-right">
                            <div class="text-xs uppercase tracking-widest text-slate-400">Ödenecek</div>
                            <div class="text-2xl font-black tabular-nums text-[#141414]" x-text="para(bolToplami)"></div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <template x-for="odeme in odemeTurleri" :key="'bo' + odeme.id">
                            <button type="button" @@click="bolOde(odeme)" :disabled="odeniyor || !bolAdedi"
                                    class="inline-flex items-center justify-center gap-2 rounded-xl py-3 px-3 font-bold text-slate-700 bg-slate-50 border-2 border-slate-100 hover:border-[#22a650] cursor-pointer select-none active:scale-95 transition disabled:opacity-40 disabled:cursor-not-allowed">
                                <span x-show="odeniyor === odeme.id">@DonenSimge("h-4 w-4")</span>
                                <span x-text="odeme.ad"></span>
                            </button>
                        </template>
                    </div>
                </div>

                @* --- İade --- *@
                <div class="space-y-3" x-show="pencere === 'iade'">
                    <div class="flex items-center justify-center gap-3 py-8 text-slate-400" x-show="iade.yukleniyor">@DonenSimge("h-5 w-5") Yükleniyor…</div>
                    <p class="text-sm text-slate-500" x-show="!iade.yukleniyor && !iade.secili">Bugün ödenen adisyonlar. Parası geri verilecek olanı seç.</p>
                    <div class="space-y-1" x-show="!iade.yukleniyor && !iade.secili">
                        <template x-for="kayit in iade.liste" :key="'i' + kayit.id">
                            <button type="button" @@click="iade.secili = kayit; iade.neden = ''; $nextTick(() => $refs.iadeNedeni.focus())"
                                    class="w-full text-left flex items-center gap-3 rounded-xl px-4 py-3 hover:bg-amber-50 cursor-pointer transition">
                                <span class="flex-1 min-w-0">
                                    <span class="block font-semibold truncate" x-text="'#' + kayit.id + ' · ' + kayit.baslik"></span>
                                    <span class="block text-xs text-slate-400" x-text="saat(kayit.kapanis) + (kayit.odemeTuru ? ' · ' + kayit.odemeTuru : '')"></span>
                                </span>
                                <b class="tabular-nums" x-text="para(kayit.toplam)"></b>
                            </button>
                        </template>
                        <p class="py-8 text-center text-slate-400" x-show="!iade.liste.length">Bugün ödenmiş adisyon yok.</p>
                    </div>
                    <form class="space-y-3" x-show="iade.secili" @@submit.prevent="iadeEt()">
                        <div class="rounded-xl p-4 bg-slate-50 flex items-center justify-between">
                            <span class="font-semibold" x-text="iade.secili ? '#' + iade.secili.id + ' · ' + iade.secili.baslik : ''"></span>
                            <b class="text-xl tabular-nums" x-text="iade.secili ? para(iade.secili.toplam) : ''"></b>
                        </div>
                        <input type="text" x-model="iade.neden" x-ref="iadeNedeni" maxlength="200" placeholder="İade nedeni örn. ürün soğuktu" class="@kutu" />
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" @@click="iade.secili = null" class="@sadeDugme">Geri</button>
                            <button type="submit" :disabled="iade.gonderiliyor" class="rounded-xl py-3 px-4 font-bold bg-rose-600 text-white hover:bg-rose-700 cursor-pointer select-none active:scale-95 transition disabled:opacity-60">İade et</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Kısa bildirim (sağ alt) *@
    <div class="fixed bottom-6 right-6 z-50 max-w-sm rounded-xl px-5 py-4 shadow-xl font-semibold text-white"
         :class="toastRengi" x-show="toast.yazi" x-transition x-text="toast.yazi" role="status"></div>
</div>

@functions {
    // Küçük çizgi simgeler (SVG): ayrı bir simge kütüphanesine gerek kalmasın
    private static readonly Dictionary<string, string> simgeYollari = new()
    {
        ["geri"] = "M15 18l-6-6 6-6",
        ["arti"] = "M12 22a10 10 0 100-20 10 10 0 000 20zM12 8v8M8 12h8",
        ["ikram"] = "M20 12v9H4v-9M2 7h20v5H2zM12 21V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z",
        ["iade"] = "M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8M3 3v5h5",
        ["bol"] = "M6 9a3 3 0 100-6 3 3 0 000 6zM6 21a3 3 0 100-6 3 3 0 000 6zM20 4L8.12 15.88M14.47 14.48L20 20M8.12 8.12L12 12",
        ["iskonto"] = "M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01",
        ["tasi"] = "M5 12h14M13 5l7 7-7 7",
        ["iptal"] = "M12 22a10 10 0 100-20 10 10 0 000 20zM15 9l-6 6M9 9l6 6",
        ["ara"] = "M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35",
        ["kisi"] = "M12 12a4 4 0 100-8 4 4 0 000 8zM4 21c0-4 4-6 8-6s8 2 8 6",
        ["saat"] = "M12 21a9 9 0 100-18 9 9 0 000 18zM12 7v5l3 2",
        ["fis"] = "M6 2h12v20l-3-2-3 2-3-2-3 2zM9 7h6M9 11h6M9 15h4",
        ["wifi"] = "M5 12.55a11 11 0 0114 0M8.5 16.1a6 6 0 017 0M2 8.82a15 15 0 0120 0M12 20h.01",
        ["sunucu"] = "M4 3h16v6H4zM4 15h16v6H4zM8 6h.01M8 18h.01"
    };

    private static Microsoft.AspNetCore.Html.HtmlString Simge(string ad, string sinif) => new(
        $"<svg class=\"{sinif}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{simgeYollari[ad]}\"/></svg>");

    // Dönen yükleniyor simgesi (spinner)
    private static Microsoft.AspNetCore.Html.HtmlString DonenSimge(string sinif) => new(
        $"<svg class=\"animate-spin {sinif}\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"/><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\"/></svg>");
}

@section Scripts {
    <script src="~/js/satis.js" asp-append-version="true"></script>
    <script src="~/lib/alpinejs/alpine.min.js" defer></script>
}
